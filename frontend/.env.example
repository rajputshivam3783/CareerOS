NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# V25.6 — the browser Content-Security-Policy ships as Report-Only until you enforce it.
# Read at BUILD time (next.config.ts). Check the browser console for
# "Content-Security-Policy-Report-Only" violations on your key pages, then set to true.
CSP_ENFORCE=false
