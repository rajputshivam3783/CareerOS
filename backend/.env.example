# Zero-config local mode uses SQLite if DATABASE_URL is omitted.
# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/careeros
DATABASE_URL=sqlite:///./careeros.db
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ENVIRONMENT=development

# V2 automated collection — off by default. Review app/ingestion/sources.py
# and confirm each enabled source's selectors match the live site before
# turning this on.
INGESTION_ENABLED=false
INGESTION_INTERVAL_MINUTES=360

# V25.7 — automatic government-job collection + detail auto-fill.
# 1) Run DB-registered sources (source_registry rows with status=active):
INGESTION_REGISTRY_ENABLED=false
INGESTION_REGISTRY_INTERVAL_MINUTES=60
# 2) Read each notification PDF/page and auto-fill vacancies, dates,
#    qualification, age, fee, pay level, selection process, ad number, apply link:
INGESTION_ENRICH_DETAILS=true
# 3) Optional LLM fallback for fields regex could not find (uses your AI provider keys; costs tokens):
INGESTION_AI_ENRICHMENT=false
INGESTION_ENRICH_MAX_PER_RUN=40
INGESTION_USER_AGENT=CareerOSBot/1.0 (+https://example.com/bot; contact: you@example.com)

# V6 Career AI — optional natural-language narration layer. Leave unset
# and the feature still works via a template-based summary (no external
# calls, no cost). Set an API key to get richer phrasing.
CAREER_AI_ANTHROPIC_API_KEY=
CAREER_AI_MODEL=claude-sonnet-5

# V20.1 AI Infrastructure — separate from the V6 key above. Powers
# Resume Intelligence, Career Copilot, Interview AI, and Skill
# Intelligence's optional AI-assisted features. Every key below is
# optional; with none set, those features return a clear "not
# configured" response rather than the app failing to start (see
# app/core/config.py). Set at least one provider key to enable them.
AI_DEFAULT_PROVIDER=gemini
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.6-flash
AI_OPENROUTER_API_KEY=

# V7 Application OS — in-app deadline/admit-card/result notifications.
# Runs by default (reads the local DB only, no outbound network calls).
DEADLINE_REMINDER_DAYS=3
NOTIFICATION_SCAN_INTERVAL_MINUTES=60

# V10 — leave true on a single worker/replica. If you run more than one
# (WEB_CONCURRENCY > 1, or multiple container replicas), set this false
# on every one of them except a single designated instance, or the
# background scheduler duplicates ingestion runs and risks duplicate
# notifications. See app/scheduler.py.
SCHEDULER_ENABLED=true
RESUME_MAX_UPLOAD_MB=8
NOTIFICATION_PDF_MAX_UPLOAD_MB=10

# V22.3 Application Documents — files are stored on disk under this
# directory (never mounted as static/public — see
# app/applications/documents.py), named only by a server-generated
# UUID, never the uploader's original filename.
APPLICATION_DOCUMENT_MAX_UPLOAD_MB=10
APPLICATION_DOCUMENT_STORAGE_DIR=var/uploads/application_documents

# Email OTP (required for real delivery in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CareerOS
SMTP_USE_TLS=true
EMAIL_OTP_MINUTES=10

# V23.2 Email Notification & Template Engine.
# EMAIL_MODE=console (default, dev/test-safe): renders every email and
#   logs it — never opens a real SMTP connection, never sends anything.
#   Use this for local development and automated tests.
# EMAIL_MODE=smtp (required for production): actually sends via the
#   SMTP_* settings above. If EMAIL_MODE=smtp and IS_PRODUCTION=true
#   but SMTP_HOST/SMTP_FROM_EMAIL are unset, the app fails fast at
#   send time with a clear error rather than silently no-op'ing —
#   see app/email/provider.py::get_provider.
EMAIL_MODE=console
EMAIL_MAX_RETRY_ATTEMPTS=4
EMAIL_RETRY_BACKOFF_SECONDS=60
EMAIL_QUEUE_INTERVAL_MINUTES=2

# V23.3 Smart Job Alerts — how often the scheduler scans for due
# alerts (INSTANT alerts are picked up on every tick; this is also
# what makes "instant" actually near-instant). DAILY/WEEKLY alerts are
# still only ever delivered once their own frequency window elapses,
# regardless of how often this runs.
JOB_ALERTS_INTERVAL_MINUTES=5

# V23.4 Communication Center — how often the reminder engine scans for
# due interview/deadline/task reminders (app.communication.reminders),
# and how often it checks whether any user's daily digest is due
# (app.communication.digest). Both are safe to run this frequently:
# every reminder/digest is idempotent (see docs/V23_4_COMMUNICATION_CENTER.md
# and docs/V23_PRODUCTION_AUDIT.md), so a tick that finds nothing new
# to send is a fast no-op.
COMMUNICATION_REMINDER_INTERVAL_MINUTES=15
COMMUNICATION_DIGEST_INTERVAL_MINUTES=60

# Optional Redis-backed rate limiter (see docker-compose.production.yml's
# `redis` profile). Leave unset for a single-instance deployment — the
# in-memory rate limiter (app/core/rate_limit.py) works fine there.
REDIS_URL=

# This file intentionally documents the variables most deployments
# actually need to touch, not every setting. Advanced/rarely-changed
# tuning knobs (session timeouts, rate-limit thresholds, DB connection
# pool sizing, per-provider AI model/timeout overrides, and more) all
# have safe defaults and live in app/core/config.py if you need them.

# ---------------------------------------------------------------------
# V25.6 — Enterprise Security & Compliance (all optional; safe defaults)
# See docs/SECURITY.md and docs/PRODUCTION_SECURITY_CHECKLIST.md.
# ---------------------------------------------------------------------
# Production start-up now REFUSES: template placeholder secrets (anything starting with
# "replace-with", "change-this", ...), wildcard/non-origin FRONTEND_ORIGIN values,
# AUTO_VERIFY_EMAIL_IN_TESTS=true, EMAIL_MODE other than smtp, and JWT_SECRET == ADMIN_API_KEY.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Reject access tokens whose session was revoked (logout / force-logout / password reset).
# One primary-key lookup per authenticated request. Leave true.
ACCESS_TOKEN_SESSION_CHECK=true

# The shared X-Admin-Key is a break-glass credential with no per-person identity. Set to false
# in production once named admin/super_admin accounts exist.
ADMIN_KEY_AUTH_ENABLED=true

# /metrics: in production it is 403 unless a token is set; then scrape with
#   Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=

# Career Agent: minutes a proposed action stays confirmable.
CAREER_AGENT_ACTION_TTL_MINUTES=1440

# Minimum seconds between password-reset codes for one account.
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Retention purge is OPT-IN. 0 = keep forever. Audit logs/security events are never purged.
# Run:  python scripts/retention_purge.py [--execute]
RETENTION_PURGE_ENABLED=false
RETENTION_AUTH_ARTIFACTS_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=365
RETENTION_EMAIL_MESSAGES_DAYS=365
RETENTION_AI_USAGE_LOGS_DAYS=365

# Deployment (docker): trusted reverse-proxy address(es) for X-Forwarded-For. Without this,
# every client appears to have the proxy's IP and shares one rate-limit bucket.
# FORWARDED_ALLOW_IPS=10.0.0.5
